#include <windows.h>
/* 程序图标：资源管理器/任务栏/Alt+Tab 显示的 exe 图标 */
101 ICON "icon.ico"
/* 版本信息（右键属性里可见，也帮助系统识别程序名） */
1 VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "HiddenProcManager"
            VALUE "FileDescription",  "隐藏进程管理器"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "HiddenProcManager"
            VALUE "OriginalFilename", "隐藏进程管理.exe"
            VALUE "ProductName",      "隐藏进程管理器"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END